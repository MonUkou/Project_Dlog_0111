<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_surface">

    <include
        android:id="@+id/bottomNavView"
        layout="@layout/inc_nav_rail"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@id/bottomNavView"
        android:orientation="horizontal">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="190dp">
                    <ImageView android:id="@+id/ivProfileCover" android:layout_width="match_parent" android:layout_height="150dp" android:contentDescription="Ảnh bìa hồ sơ" android:scaleType="centerCrop" android:src="@drawable/profile_cover_sample" />
                    <ImageView android:id="@+id/btnProfileSettings" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_profile_camera" android:contentDescription="Cài đặt hồ sơ" android:padding="13dp" android:src="@drawable/ic_settings_24" app:tint="@color/white" />
                    <FrameLayout android:id="@+id/btnChangeCoverProfile" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_marginEnd="8dp" android:layout_marginBottom="32dp" android:contentDescription="Đổi ảnh bìa" android:visibility="gone">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/bg_profile_camera" android:importantForAccessibility="no" android:padding="7dp" android:src="@drawable/ic_camera_24" />
                    </FrameLayout>
                    <FrameLayout android:layout_width="92dp" android:layout_height="92dp" android:layout_gravity="bottom|start" android:layout_marginStart="16dp">
                        <ImageView android:id="@+id/ivProfileAvatar" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_profile_avatar_ring" android:contentDescription="Ảnh đại diện" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/bg_circle_avatar" />
                        <FrameLayout android:id="@+id/btnChangeAvatarProfile" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:contentDescription="Đổi ảnh đại diện" android:visibility="gone">
                            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_profile_camera" android:importantForAccessibility="no" android:padding="7dp" android:src="@drawable/ic_camera_24" />
                        </FrameLayout>
                    </FrameLayout>
                </FrameLayout>
                <TextView android:id="@+id/tvFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="Tên hiển thị" android:textColor="@color/dlog_navy" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="3dp" android:text="Giới thiệu ngắn về bản thân." android:textColor="@color/dlog_navy" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <Button android:id="@+id/btnMessageProfile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_profile_action" android:backgroundTint="@color/dlog_button" android:text="Nhắn tin" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
                    <Button android:id="@+id/btnProfileActionButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_profile_action" android:backgroundTint="@color/dlog_button" android:text="Sửa hồ sơ" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/llProfileStats" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvPostsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/dlog_navy" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ảnh" android:textColor="@color/dlog_muted_blue" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnShowFollowers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvFollowersCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/dlog_navy" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theo dõi" android:textColor="@color/dlog_muted_blue" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnShowFollowing" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvFollowingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/dlog_navy" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang theo dõi" android:textColor="@color/dlog_muted_blue" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/dlog_feed_divider" />

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvOfflineProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/dlog_border" android:gravity="center" android:padding="7dp" android:text="Ngoại tuyến · Đang xem dữ liệu SQLite" android:textColor="@color/dlog_navy" android:textSize="12sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/llProfileTabs" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
                <TextView android:id="@+id/tabUserPosts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Ảnh đã chia sẻ" android:textColor="@color/dlog_blue" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tabSavedPosts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Đã lưu" android:textColor="@color/dlog_muted_blue" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/profileSortBar" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:background="@color/dlog_surface">
                <TextView android:id="@+id/profileSortNewest" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:text="Mới nhất" android:textColor="@color/dlog_blue" android:contentDescription="Sắp xếp ảnh mới nhất" />
                <TextView android:id="@+id/profileSortOldest" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:text="Cũ nhất" android:textColor="@color/dlog_muted_blue" android:contentDescription="Sắp xếp ảnh cũ nhất" />
                <TextView android:id="@+id/profileSortPopular" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:text="Phổ biến" android:textColor="@color/dlog_muted_blue" android:contentDescription="Sắp xếp ảnh phổ biến" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dlog_feed_divider" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvProfilePosts" android:layout_width="match_parent" android:layout_height="match_parent" android:nestedScrollingEnabled="true" />
                <ProgressBar android:id="@+id/progressBarProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/tvStateProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:text="Chưa có ảnh nào" android:textColor="@color/dlog_muted_blue" android:textSize="14sp" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
