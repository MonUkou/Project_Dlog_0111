<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlogDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_feed_background">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <include android:id="@+id/bottomNavView" layout="@layout/inc_nav_rail" android:layout_width="64dp" android:layout_height="match_parent" android:layout_alignParentEnd="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_toStartOf="@id/bottomNavView" android:background="@color/dlog_feed_background" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="" android:src="@drawable/ic_menu_24" android:tint="@color/dlog_blue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Menu DLog" android:textColor="@color/dlog_navy" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Vuốt từ cạnh trái để mở menu" android:textColor="@color/dlog_muted_blue" android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
    <include layout="@layout/inc_drawer_panel" />
</androidx.drawerlayout.widget.DrawerLayout>
