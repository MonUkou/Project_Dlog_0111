<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@color/dlog_surface"
    android:elevation="8dp"
    android:orientation="horizontal">
    <TextView android:id="@+id/navFeed" style="@style/DLogLandscapeNavIcon" android:contentDescription="Bảng tin" android:drawableTop="@drawable/ic_home_24" />
    <TextView android:id="@+id/navSearch" style="@style/DLogLandscapeNavIcon" android:contentDescription="Khám phá" android:drawableTop="@drawable/ic_explore_24" />
    <TextView android:id="@+id/navInbox" style="@style/DLogLandscapeNavIcon" android:contentDescription="Hộp thư" android:drawableTop="@drawable/ic_chat_24" />
    <TextView android:id="@+id/navProfile" style="@style/DLogLandscapeNavIcon" android:contentDescription="Hồ sơ" android:drawableTop="@drawable/ic_person_outline" />
</LinearLayout>
