<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_feed_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/bottomNavView"
            layout="@layout/inc_nav_rail"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true" />

        <LinearLayout
            android:id="@+id/headerHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/bottomNavView"
            android:background="@color/dlog_surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnMenuHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mở menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24"
                app:tint="@color/dlog_navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvHomeLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="DLog"
                    android:textColor="@color/dlog_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chia sẻ khoảnh khắc, kết nối đam mê"
                    android:textColor="@color/dlog_muted_blue"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSearchHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tìm kiếm"
                android:padding="12dp"
                android:src="@drawable/ic_search_24"
                app:tint="@color/dlog_navy" />

            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <ImageButton
                    android:id="@+id/btnNotificationsHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Thông báo"
                    android:padding="12dp"
                    android:src="@drawable/ic_notifications_24"
                    app:tint="@color/dlog_navy" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_notification_dot" />
            </FrameLayout>
        </LinearLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/feedCoordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerHome"
            android:layout_toStartOf="@id/bottomNavView">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/feedAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dlog_surface"
                android:elevation="1dp">

                <LinearLayout
                    android:id="@+id/feedIntro"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    app:layout_scrollFlags="scroll">

                    <LinearLayout
                        android:id="@+id/quickCreatePost"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/dlog_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <ImageView
                            android:id="@+id/ivQuickCreateAvatar"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:contentDescription="Ảnh đại diện"
                            android:scaleType="centerCrop" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_auth_input"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:text="Bạn đang nghĩ gì?"
                            android:textColor="@color/dlog_muted_blue"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:contentDescription="Tạo bài viết"
                            android:padding="11dp"
                            android:src="@drawable/ic_add_24"
                            app:tint="@color/dlog_blue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/peopleSection"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/dlog_surface"
                        android:orientation="vertical"
                        android:paddingTop="2dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:text="Đang theo dõi"
                            android:textColor="@color/dlog_navy"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPeople"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFeed"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp" />
                    <ProgressBar
                        android:id="@+id/progressBarFeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvStateFeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="Chưa có ảnh nào"
                        android:textColor="@color/dlog_muted_blue"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <ImageButton
                android:id="@+id/btnScrollToTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_scroll_to_top"
                android:contentDescription="Cuộn lên đầu bảng tin"
                android:elevation="6dp"
                android:padding="14dp"
                android:src="@drawable/ic_arrow_up_24"
                app:tint="@color/dlog_on_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOfflineFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_admin_status"
                android:drawableStart="@drawable/ic_cloud_off_24"
                android:drawablePadding="8dp"
                android:elevation="5dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:text="Đang xem dữ liệu đã lưu trên máy"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </RelativeLayout>

    <include layout="@layout/inc_drawer_panel" />
</androidx.drawerlayout.widget.DrawerLayout>
