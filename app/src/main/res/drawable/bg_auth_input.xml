<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dlog_surface" />
            <stroke android:width="1.5dp" android:color="@color/dlog_blue" />
            <corners android:radius="@dimen/auth_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dlog_surface" />
            <stroke android:width="1dp" android:color="@color/dlog_border" />
            <corners android:radius="@dimen/auth_corner_radius" />
        </shape>
    </item>
</selector>
