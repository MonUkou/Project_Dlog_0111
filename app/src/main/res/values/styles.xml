<resources>
    <style name="DLog.Text.Title" parent="android:style/TextAppearance.Material">
        <item name="android:textColor">@color/dlog_ink</item>
        <item name="android:textSize">@dimen/auth_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DLog.Text.Body" parent="android:style/TextAppearance.Material">
        <item name="android:textColor">@color/dlog_muted</item>
        <item name="android:textSize">@dimen/auth_text_body</item>
    </style>

    <style name="DLog.Text.Label" parent="android:style/TextAppearance.Material">
        <item name="android:textColor">@color/dlog_ink</item>
        <item name="android:textSize">@dimen/auth_text_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DLog.Button.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">@dimen/auth_button_height</item>
        <item name="android:textColor">@color/dlog_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="DLogMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DLogDrawerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="DLogDrawerIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">#FFFFFF</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="DLogDrawerText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="DLogSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_post_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/dlog_navy</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DLogAdminTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textColor">#D6E4F7</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
