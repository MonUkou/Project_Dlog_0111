<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_surface">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerEditProfile"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="@color/dlog_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBackEditProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:tint="@color/dlog_navy"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Sửa hồ sơ"
            android:textColor="@color/dlog_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_black"
            android:text="Lưu"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />
    </RelativeLayout>

    <View
        android:id="@+id/dividerEditProfile"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/headerEditProfile"
        android:background="@color/dlog_feed_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerEditProfile"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivEditAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/bg_circle_avatar"
                android:scaleType="centerCrop"
                android:contentDescription="Avatar" />

            <TextView
                android:id="@+id/btnChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="Đổi ảnh đại diện"
                android:textColor="@color/dlog_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

            <ImageView android:id="@+id/ivEditCover" android:layout_width="match_parent"
                android:layout_height="150dp" android:layout_marginTop="16dp" android:scaleType="centerCrop"
                android:src="@drawable/profile_cover_sample" android:contentDescription="Ảnh bìa xem trước" />
            <Button android:id="@+id/btnChangeCover" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="Đổi ảnh bìa" />
            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên người dùng (Username)"
                android:textColor="@color/dlog_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_edittext"
                android:hint="Tên người dùng"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/dlog_navy"
                android:textSize="15sp" />

            <!-- Full Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên hiển thị"
                android:textColor="@color/dlog_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_edittext"
                android:hint="Tên hiển thị"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/dlog_navy"
                android:textSize="15sp" />

            <!-- Bio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Giới thiệu bản thân"
                android:textColor="@color/dlog_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditBio"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_edittext"
                android:gravity="top|start"
                android:hint="Giới thiệu ngắn về bản thân..."
                android:padding="12dp"
                android:textColor="@color/dlog_navy"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/progressBarEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
