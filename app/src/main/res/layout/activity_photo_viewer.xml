<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF000000">
    <com.example.myapplication.view.ZoomDismissImageView android:id="@+id/zoomPhoto" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Ảnh toàn màn hình" />
    <ImageButton android:id="@+id/btnCloseViewer" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:layout_margin="12dp" android:background="@drawable/bg_photo_nav" android:contentDescription="Đóng xem ảnh" android:padding="14dp" android:src="@drawable/ic_close_white_24" />
    <ImageButton android:id="@+id/btnPhotoInfo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="12dp" android:background="@drawable/bg_photo_nav" android:contentDescription="Xem thông số ảnh" android:padding="14dp" android:src="@drawable/ic_info_white_24" />
    <ImageButton android:id="@+id/btnViewerPrevious" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|start" android:background="@drawable/bg_photo_nav" android:contentDescription="Ảnh trước" android:padding="15dp" android:src="@drawable/ic_chevron_left_white_24" />
    <ImageButton android:id="@+id/btnViewerNext" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|end" android:background="@drawable/bg_photo_nav" android:contentDescription="Ảnh tiếp theo" android:padding="15dp" android:src="@drawable/ic_chevron_right_white_24" />
    <TextView android:id="@+id/tvViewerDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp" android:background="@drawable/bg_admin_status" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:textColor="@color/white" android:textSize="12sp" />
</FrameLayout>
