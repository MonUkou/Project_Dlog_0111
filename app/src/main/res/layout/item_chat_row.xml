<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="11dp">
    <ImageView
        android:id="@+id/ivChatRowAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_circle_avatar"
        android:contentDescription="Ảnh đại diện"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvChatRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/dlog_navy"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvChatRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/dlog_muted_blue"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
