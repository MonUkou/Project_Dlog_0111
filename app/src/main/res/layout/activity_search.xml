<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header / Search input -->
    <LinearLayout
        android:id="@+id/headerSearch"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:padding="10dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rounded_edittext"
            android:hint="Tìm kiếm người dùng..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/dlog_navy"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/dividerSearch"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/headerSearch"
        android:background="@color/dlog_feed_divider" />

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavView"
        layout="@layout/inc_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

    <!-- Search Results List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerSearch"
        android:layout_above="@id/bottomNavView">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBarSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptySearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nhập từ khóa để tìm kiếm"
            android:textColor="@color/dlog_muted_blue"
            android:textSize="15sp" />
    </FrameLayout>

</RelativeLayout>
