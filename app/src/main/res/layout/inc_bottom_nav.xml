<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@color/dlog_surface"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/navFeed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableTop="@drawable/ic_home_24"
        android:drawablePadding="2dp"
        android:drawableTint="@color/dlog_blue"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="3dp"
        android:text="Bảng tin"
        android:textColor="@color/dlog_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navSearch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableTop="@drawable/ic_explore_24"
        android:drawablePadding="2dp"
        android:drawableTint="@color/dlog_nav_inactive"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="3dp"
        android:text="Khám phá"
        android:textColor="@color/dlog_nav_inactive"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/navInbox"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableTop="@drawable/ic_chat_24"
        android:drawablePadding="2dp"
        android:drawableTint="@color/dlog_nav_inactive"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="3dp"
        android:text="Hộp thư"
        android:textColor="@color/dlog_nav_inactive"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableTop="@drawable/ic_person_outline"
        android:drawablePadding="2dp"
        android:drawableTint="@color/dlog_nav_inactive"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="3dp"
        android:text="Hồ sơ"
        android:textColor="@color/dlog_nav_inactive"
        android:textSize="12sp" />
</LinearLayout>
