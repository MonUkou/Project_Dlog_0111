<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:id="@+id/btnBackRegister"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/dlog_navy"
                android:textSize="30sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng ký"
            android:textColor="@color/dlog_navy"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tạo tài khoản để bắt đầu chia sẻ!"
            android:textColor="@color/dlog_muted_blue"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_auth_input"
            android:drawableStart="@drawable/ic_person_outline"
            android:drawablePadding="9dp"
            android:drawableTint="@color/dlog_blue"
            android:gravity="center_vertical"
            android:hint="Họ và tên"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:autofillHints="name"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/dlog_ink"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:drawableStart="@drawable/ic_email_outline"
            android:drawablePadding="9dp"
            android:drawableTint="@color/dlog_blue"
            android:gravity="center_vertical"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:autofillHints="emailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/dlog_ink"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:drawableStart="@drawable/ic_lock_outline"
            android:drawableEnd="@drawable/ic_visibility_24"
            android:drawablePadding="9dp"
            android:drawableTint="@color/dlog_blue"
            android:gravity="center_vertical"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:maxLines="1"
            android:autofillHints="newPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/dlog_ink"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:drawableStart="@drawable/ic_lock_outline"
            android:drawableEnd="@drawable/ic_visibility_24"
            android:drawablePadding="9dp"
            android:drawableTint="@color/dlog_blue"
            android:gravity="center_vertical"
            android:hint="Nhập lại mật khẩu"
            android:inputType="textPassword"
            android:maxLines="1"
            android:autofillHints="newPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/dlog_ink"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbAcceptTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:buttonTint="@color/dlog_blue"
            android:gravity="top"
            android:text="Tôi đồng ý với Điều khoản sử dụng và Chính sách bảo mật"
            android:textColor="@color/dlog_navy"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressRegister"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:indeterminate="true"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnRegister"
            style="@style/DLog.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_auth_button"
            android:text="Đăng ký" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/dlog_feed_divider" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:text="Hoặc đăng ký với" android:textColor="@color/dlog_muted_blue" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/dlog_feed_divider" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnGoogleRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_social_button"
            android:clickable="true"
            android:contentDescription="Tiếp tục với Google"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_google_g" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tiếp tục với Google"
                android:textColor="@color/dlog_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvGoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Đã có tài khoản? Đăng nhập"
            android:textColor="@color/dlog_navy"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
