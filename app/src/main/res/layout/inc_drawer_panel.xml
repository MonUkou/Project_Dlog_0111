<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerPanel"
    android:layout_width="304dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/dlog_drawer"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dlog_drawer"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="24dp">
            <ImageView
                android:id="@+id/ivMenuAvatar"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_avatar"
                android:contentDescription="Ảnh đại diện"
                android:scaleType="centerCrop" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvMenuName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Người dùng DLog"
                    android:textColor="@color/dlog_on_drawer"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMenuUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@dlog_user"
                    android:textColor="@color/dlog_on_drawer_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="DLog"
            android:textColor="@color/dlog_on_drawer"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout android:id="@+id/rowMenuProfile" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_person_outline" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Hồ sơ của tôi" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuSaved" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_bookmark_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Bài viết đã lưu" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuCreate" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_add_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Tạo bài viết" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuNotifications" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_notifications_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Thông báo" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuChats" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_chat_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Hộp thư" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#456080" />

        <LinearLayout android:id="@+id/rowMenuSettings" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_settings_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Cài đặt" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuAdmin" style="@style/DLogDrawerRow" android:visibility="gone">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_settings_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Quản trị" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowMenuHelp" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_info_outline_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Trợ giúp và hỗ trợ" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout android:id="@+id/rowMenuLogout" style="@style/DLogDrawerRow">
            <ImageView style="@style/DLogDrawerIcon" android:src="@drawable/ic_logout_24" android:contentDescription="" />
            <TextView style="@style/DLogDrawerText" android:text="Đăng xuất" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
