<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_surface">

    <!-- Thanh tiêu đề -->
    <RelativeLayout
        android:id="@+id/headerCreatePost"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dlog_surface"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackCreate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_back"/>

        <TextView
            android:id="@+id/tvCreateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chia sẻ ảnh"
            android:textColor="@color/dlog_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmitPost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_auth_button"
            android:minHeight="0dp"
            android:minWidth="72dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Chia sẻ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Đường phân cách -->
    <View
        android:id="@+id/dividerCreate"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/headerCreatePost"
        android:background="@color/dlog_border" />

    <!-- Ảnh là nội dung chính; mô tả ngắn nằm phía dưới. -->
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerCreate"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thông tin người đăng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivCreateAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_story_ring"
                    android:contentDescription="Ảnh đại diện"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_outline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCreateName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khoảnh khắc của bạn"
                        android:textColor="@color/dlog_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chọn ảnh để chia sẻ"
                        android:textColor="@color/dlog_muted"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Khu vực chọn ảnh -->
            <FrameLayout
                android:id="@+id/btnSelectImage"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_post_photo"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Gợi ý khi chưa chọn ảnh -->
                <LinearLayout
                    android:id="@+id/llImagePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_photo_library_48"
                         />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Chọn ảnh để chia sẻ"
                        android:textColor="@color/dlog_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Từ thiết bị hoặc thư viện DLog"
                        android:textColor="@color/dlog_muted"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/photoCollage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chọn tối đa 10 ảnh"
                android:textColor="@color/dlog_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddMoreImages"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="＋ Thêm ảnh thứ 2"
                    android:textColor="@color/dlog_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnEditSelectedImage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Chỉnh ảnh đầu"
                    android:textColor="@color/dlog_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/etCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="Thêm vài lời về ảnh..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2"
                android:minHeight="48dp"
                android:padding="4dp"
                android:textColor="@color/dlog_ink"
                android:textColorHint="@color/dlog_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etHashtags"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Thêm chủ đề #dulich #ueh"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/dlog_ink"
                android:textColorHint="@color/dlog_muted"
                android:contentDescription="Hashtag chủ đề" />

            <!-- Trạng thái đăng bài -->
            <LinearLayout
                android:id="@+id/llLoadingCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/dlog_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Đang tải ảnh lên..."
                    android:textColor="@color/dlog_muted"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
