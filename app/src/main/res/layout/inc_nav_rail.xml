<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavContainer"
    android:layout_width="64dp"
    android:layout_height="match_parent"
    android:background="@color/dlog_surface"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="vertical">

    <Space
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/navFeed"
        style="@style/DLogNavRailIcon"
        android:contentDescription="Bảng tin"
        android:src="@drawable/ic_home_24" />

    <Space
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/navSearch"
        style="@style/DLogNavRailIcon"
        android:contentDescription="Khám phá"
        android:src="@drawable/ic_explore_24" />

    <Space
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/navInbox"
        style="@style/DLogNavRailIcon"
        android:contentDescription="Hộp thư"
        android:src="@drawable/ic_chat_24" />

    <Space
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/navProfile"
        style="@style/DLogNavRailIcon"
        android:contentDescription="Hồ sơ"
        android:src="@drawable/ic_person_outline" />

    <Space
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
