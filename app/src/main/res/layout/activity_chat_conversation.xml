<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/btnBackConversation"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/dlog_navy"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/ivConversationAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_circle_avatar"
            android:contentDescription="Ảnh đại diện"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/tvConversationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tin nhắn"
            android:textColor="@color/dlog_navy"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
        <TextView
            android:id="@+id/tvMessagesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Bắt đầu cuộc trò chuyện bằng một lời chào 👋"
            android:textColor="@color/dlog_muted_blue"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_input"
            android:hint="Nhập tin nhắn..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:textColor="@color/dlog_navy"
            android:textColorHint="@color/dlog_muted_blue"
            android:textSize="14sp" />
        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_auth_button"
            android:contentDescription="Gửi tin nhắn"
            android:padding="11dp"
            android:src="@drawable/ic_send_24"
            android:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
