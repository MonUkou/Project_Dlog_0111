<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlog_feed_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Ảnh nền phía trên -->
    <ImageView
        android:id="@+id/ivLoginCover"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:contentDescription="Ảnh bìa DLog"
        android:scaleType="centerCrop"
        android:src="@drawable/library_photo_24" />

    <!-- Logo và thông điệp thương hiệu -->


    <!-- Khung đăng nhập -->
    <ScrollView
        android:id="@+id/svLoginForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="190dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:focusableInTouchMode="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="12dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_sheet"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập"
                android:textColor="@color/dlog_navy"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chào mừng bạn quay trở lại!"
                android:textColor="@color/dlog_muted_blue"
                android:textSize="14sp" />

            <!-- Email -->
            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_field_height"
                android:layout_marginTop="16dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_auth_input"
                android:drawableStart="@drawable/ic_email_outline"
                android:drawablePadding="9dp"
                android:drawableTint="@color/dlog_blue"
                android:gravity="center_vertical"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="true"
                android:textColor="@color/dlog_ink"
                android:textColorHint="@color/dlog_muted_blue"
                android:textSize="14sp" />

            <!-- Mật khẩu -->
            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_field_height"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/bg_auth_input"
                android:drawableStart="@drawable/ic_lock_outline"
                android:drawableEnd="@drawable/ic_visibility_24"
                android:drawablePadding="9dp"
                android:drawableTint="@color/dlog_blue"
                android:gravity="center_vertical"
                android:hint="Mật khẩu"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="true"
                android:textColor="@color/dlog_ink"
                android:textColorHint="@color/dlog_muted_blue"
                android:textSize="14sp" />

            <!-- Ghi nhớ và quên mật khẩu -->
            <!-- Ghi nhớ và quên mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical|end"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="Quên mật khẩu?"
                    android:textColor="@color/dlog_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Trạng thái đăng nhập -->
            <ProgressBar
                android:id="@+id/progressBarLogin"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Nút đăng nhập -->
            <Button
                android:id="@+id/btnLoginSubmit"
                style="@style/DLog.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_button"
                android:minHeight="48dp"
                android:text="Đăng nhập"
                android:textAllCaps="false" />

            <!-- Phân cách -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/dlog_feed_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Hoặc đăng nhập với"
                    android:textColor="@color/dlog_muted_blue"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/dlog_feed_divider" />

            </LinearLayout>

            <!-- Google -->
            <LinearLayout
                android:id="@+id/btnGoogleLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:contentDescription="Tiếp tục với Google"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_google_g" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Tiếp tục với Google"
                    android:textColor="@color/dlog_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Chuyển sang đăng ký -->
            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:padding="8dp"
                android:text="Chưa có tài khoản? Đăng ký"
                android:textColor="@color/dlog_navy"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
